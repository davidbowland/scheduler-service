# AWS SAM
.aws-sam/

# SWC compiler cache
.swc/

# Node artifact files
# No trailing slash on node_modules: parallel-agent worktrees symlink it rather
# than reinstalling, and a trailing slash only matches directories, so `git add -A`
# in a worktree would stage the symlink.
node_modules
dist/
coverage/
public/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

